<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LLM tree View -->
    <record id="sh_ai_llm_view_tree" model="ir.ui.view">
        <field name="name">sh.ai.llm.tree</field>
        <field name="model">sh.ai.llm</field>
        <field name="arch" type="xml">
            <tree string="LLM Providers">
                <field name="image" widget="image" options="{'size': [40, 40]}" optional="show"/>
                <field name="name"/>
                <field name="provider_type"
                       widget="badge"
                       decoration-info="provider_type == 'direct'"
                       decoration-success="provider_type == 'openrouter'"/>
                <field name="sh_company"/>
                <field name="sh_model_code"/>
                <field name="is_default" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- LLM Form View -->
    <record id="sh_ai_llm_view_form" model="ir.ui.view">
        <field name="name">sh.ai.llm.form</field>
        <field name="model">sh.ai.llm</field>
        <field name="arch" type="xml">
            <form string="LLM Provider">
                <field name="is_gpt_5_model" invisible="1"/>
                <field name="is_reasoning_model" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                        attrs="{'invisible': [('is_gpt_5_model', '=', False)]}">
                    <span>⚠ GPT-5 models does not support response type.</span>
                </div>
                <sheet>
                    <div class="oe_button_box" position="inside"/>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. GPT-4o"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <label for="provider_type"/>
                            <div class="o_row" name="provider_type_row">
                                <field name="provider_type" nolabel="1" class="oe_inline"/>
                                <button name="action_fetch_openrouter_models"
                                        string="Fetch Models"
                                        type="object"
                                        class="oe_highlight oe_inline ms-2"
                                        attrs="{'invisible': [('provider_type', '!=', 'openrouter')]}"
                                        groups="sh_ai_base.group_sh_ai_manager"/>
                            </div>
                            <field name="openrouter_model_id"
                                   groups="sh_ai_base.group_sh_ai_manager"
                                   attrs="{'invisible': [('provider_type', '!=', 'openrouter')]}"
                                   domain="[('active', '=', True)]"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="sh_company"
                                   placeholder="e.g. OpenAI"
                                   attrs="{'readonly': [('provider_type', '=', 'openrouter')], 'required': [('provider_type', '=', 'direct')]}"
                                   force_save="1"/>
                            <field name="sh_model_code"
                                   placeholder="e.g. gpt-4o or gemini-2.5-flash"
                                   attrs="{'readonly': [('provider_type', '=', 'openrouter')], 'required': [('provider_type', '=', 'direct')]}"
                                   force_save="1"/>
                            <field name="temperature" attrs="{'invisible': [('is_gpt_5_model', '=', True)]}"/>
                            <field name="sh_reasoning_effort" attrs="{'invisible': [('is_reasoning_model', '=', False)], 'required': [('is_reasoning_model', '=', True)]}"/>
                        </group>
                        <group>
                            <field name="sh_api_key" password="True" placeholder="Your API key..."/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="is_default" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
              
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LLM Action -->
    <record id="action_sh_ai_llm" model="ir.actions.act_window">
        <field name="name">LLM Providers</field>
        <field name="res_model">sh.ai.llm</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first LLM Provider!
            </p>
            <p>
                Configure LLM providers like OpenAI, Google, Anthropic to use with your AI assistants.
            </p>
        </field>
    </record>

</odoo>
