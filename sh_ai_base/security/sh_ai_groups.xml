<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- AI Base Privilege -->
        <record model="res.groups.privilege" id="res_groups_privilege_ai_base">
            <field name="name">AI Accessibility</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="base.module_category_productivity"/>
        </record>

        <!-- AI User Group -->
        <record id="group_sh_ai_user" model="res.groups">
            <field name="name">User: Access AI features</field>
            <field name="privilege_id" ref="res_groups_privilege_ai_base"/>
            <field name="comment">Can Access AI functionality and view basic AI features</field>
        </record>

        <!-- AI Manager Group -->
        <record id="group_sh_ai_manager" model="res.groups">
            <field name="name">Manager: Configure AI Settings</field>
            <field name="privilege_id" ref="res_groups_privilege_ai_base"/>
            <field name="implied_ids" eval="[(4, ref('group_sh_ai_user'))]"/>
            <field name="comment">Full access to AI configuration, LLM providers, and API key management</field>
        </record>

        <!-- Give System Admin AI Manager privileges by default -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_sh_ai_manager'))]"/>
        </record>

    </data>
</odoo>