<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sh_ai_assistance.AiChatAppTemplate" owl="1">
        <div class="o-ai-Chat d-flex h-100 flex-grow-1 border-top">

            <!-- ============================================ -->
            <!-- ONBOARDING WIZARD (for managers)             -->
            <!-- ============================================ -->
            <t t-if="state.showOnboarding">
                <AiOnboardingWizard
                    onComplete.bind="onOnboardingComplete"
                    onSkip.bind="onOnboardingSkip"
                    onboardingState="state.onboardingState"/>
            </t>

            <!-- ============================================ -->
            <!-- BLOCKER SCREEN (for users, when not set up)  -->
            <!-- ============================================ -->
            <t t-elif="state.showBlocker">
                <div class="ai-onboarding-wizard">
                    <div class="onboarding-screen blocker-screen">
                        <div class="onboarding-content">
                            <div class="blocker-icon">🔧</div>
                            <h2 class="blocker-title">AI Assistant is being set up</h2>
                            <p class="blocker-subtitle">
                                Your administrator needs to complete the initial
                                configuration before you can start using AI Chat.
                            </p>
                            <p class="blocker-hint">
                                Please contact your system administrator.
                            </p>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ============================================ -->
            <!-- NORMAL CHAT UI                               -->
            <!-- ============================================ -->
            <t t-else="">
                <t t-if="state.isLoading">
                    <!-- Full Loading Screen -->
                    <div class="ai-loading-screen">
                        <div class="ai-loading-content">
                            <div class="ai-loading-icon">
                                <i class="fa fa-comments-o"/>
                            </div>
                            <div class="ai-loading-spinner"/>
                            <span class="ai-loading-text">Preparing your AI Assistant...</span>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <!-- Sidebar -->
                    <div class="o-ai-SidebarShell d-flex flex-column border-end position-relative"
                         t-att-class="state.sidebarCollapsed ? 'collapsed' : ''">

                        <AiChatSidebar
                            sessions="state.sessions"
                            projectTree="projectTreeData"
                            projectState="state.projectState"
                            currentSessionToken="state.currentSessionToken"
                            currentSessionProjectId="currentSessionProjectId"
                            isCollapsed="state.sidebarCollapsed"
                            isLoading="state.isLoading"
                            onNewChat.bind="createNewSession"
                            onSelectSession.bind="selectSession"
                            onToggleSidebar.bind="toggleSidebar"
                            onDeleteSession.bind="deleteSession"
                            onRenameSession.bind="renameSession"
                            onCreateProject.bind="createProject"
                            onRenameProject.bind="renameProject"
                            onDeleteProject.bind="deleteProject"
                            onMoveProjectToProject.bind="moveProjectToProject"
                            onMoveSessionToProject.bind="moveSessionToProject"
                            onToggleProject.bind="toggleProject"
                            onExpandAllProjects.bind="expandAllProjects"
                            onCollapseAllProjects.bind="collapseAllProjects"
                            onImportSuccess.bind="onImportSuccess"/>
                        
                     </div>

                    <!-- Main Content Area -->
                    <div class="flex-grow-1 d-flex flex-column position-relative overflow-hidden">
                        <!-- Main Chat Component -->
                        <AiChatMain
                            sessionToken="state.currentSessionToken"
                            currentLlmCompany="currentLlmCompany"
                            onSessionRenamed.bind="onSessionRenamed"
                            onMessageSent.bind="onMessageSent"
                            onModelChanged.bind="onModelChanged"/>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
