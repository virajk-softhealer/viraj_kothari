<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sh_ai_assistance.AiChatWindowMessageTemplate" owl="1">
        <div class="sh-ai-window-chat-message" t-att-class="props.message.message_type + '-message'">
            <img class="sh-ai-window-message-avatar"
                 t-att-src="avatarUrl"
                 t-att-alt="authorName"/>

            <div class="sh-ai-window-message-body">
                <div class="sh-ai-window-message-meta d-flex align-items-center justify-content-between gap-2 mt-1">
                    <div class="sh-ai-window-author-info d-flex align-items-center gap-2">
                        <t t-if="props.message.message_type === 'user' and props.message.sh_is_cancelled">
                            <span class="badge rounded-pill bg-danger smaller" style='color:black;'>Cancelled</span>
                        </t>
                        <span class="sh-ai-window-message-time" t-att-title="fullTimestamp" t-esc="formattedTime"/>
                        <t t-if="reasoningEffortLabel">
                            <span class="sh-ai-window-message-reasoning ms-1" t-att-title="'Reasoning Effort: ' + reasoningEffortLabel" style="font-size: 8px; color: #6366F1; opacity: 0.8; font-weight: 500;">
                                <i class="fa fa-lightbulb-o me-1"/>
                                <t t-esc="reasoningEffortLabel"/>
                            </span>
                        </t>
                    </div>
                </div>

                <div class="sh-ai-window-message-bubble" t-att-class="isErrorMessage ? 'error-message' : ''" t-att-style="isErrorMessage ? 'background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-top-left-radius: 8px;' : ''">
                    <t t-if="props.message.message_type === 'assistant'">
                        <div t-out="richContent"/>
                        

                        <t t-if="hasWriteRequest">
                            <div class="sh-ai-window-write-request-card mt-3">
                                <div class="sh-ai-window-write-request-header">
                                    <div>
                                        <div class="sh-ai-window-write-request-title" t-esc="writeRequestTitle"/>
                                        <div class="sh-ai-window-write-request-subtitle" t-esc="writeRequestSummary"/>
                                    </div>
                                    <span class="sh-ai-window-write-request-state" t-att-class="'is-' + (writeRequest.state || 'pending')" t-esc="writeRequestStateLabel"/>
                                </div>

                                <t t-if="writeRiskBadges.length">
                                    <div class="sh-ai-window-write-badge-row mt-2">
                                        <span t-foreach="writeRiskBadges" t-as="badge" t-key="badge.code" class="sh-ai-window-write-badge" t-esc="badge.label"/>
                                    </div>
                                </t>

                                <t t-if="writeFieldDiffs.length">
                                    <div class="sh-ai-window-write-diff-list mt-3">
                                        <div t-foreach="writeFieldDiffs" t-as="diff" t-key="diff.field" class="sh-ai-window-write-diff-item">
                                            <div class="sh-ai-window-write-diff-label" t-esc="diff.label"/>
                                            <div class="sh-ai-window-write-diff-values">
                                                <div class="sh-ai-window-write-diff-line"><span class="sh-ai-window-write-diff-line-key">Before:</span> <span t-esc="diff.before_summary"/></div>
                                                <div class="sh-ai-window-write-diff-line"><span class="sh-ai-window-write-diff-line-key">After:</span> <span t-esc="diff.after_summary"/></div>
                                            </div>
                                        </div>
                                    </div>
                                </t>

                                <t t-if="writeSampleRecords.length">
                                    <div class="sh-ai-window-write-sample-list mt-3">
                                        <div t-foreach="writeSampleRecords" t-as="sample" t-key="sample.id or sample.display_name" class="sh-ai-window-write-sample-item">
                                            <div class="sh-ai-window-write-sample-title" t-esc="sample.display_name"/>
                                            <t t-if="sample.before">
                                                <div class="sh-ai-window-write-sample-meta text-muted small">Current preview available</div>
                                            </t>
                                        </div>
                                    </div>
                                </t>

                                <t t-if="writeResultMessage">
                                    <div class="sh-ai-window-write-result-message mt-3" t-esc="writeResultMessage"/>
                                </t>
                                <t t-if="!writeResultMessage and writeFailureMessage and ['failed', 'rejected', 'expired'].includes(writeRequest.state)">
                                    <div class="sh-ai-window-write-result-message sh-ai-window-write-result-error mt-3" t-esc="writeFailureMessage"/>
                                </t>

                                <div class="sh-ai-window-write-action-row mt-3">
                                    <button t-if="canApproveWriteRequest" class="btn btn-sm btn-primary sh-ai-window-write-action-icon" t-on-click="approveWriteRequest" t-att-title="'Approve'" t-att-disabled="props.isProcessing">
                                        <i class="fa fa-check"/>
                                    </button>
                                    <button t-if="canRejectWriteRequest" class="btn btn-sm btn-outline-secondary sh-ai-window-write-action-icon" t-on-click="rejectWriteRequest" t-att-title="'Reject'" t-att-disabled="props.isProcessing">
                                        <i class="fa fa-times"/>
                                    </button>
                                    <button t-if="canOpenWriteRequestRecords" class="btn btn-sm btn-outline-primary sh-ai-window-open-records-button" t-on-click="openWriteRequestRecords" t-att-disabled="props.isProcessing">
                                        <i class="fa fa-list-ul me-1"/>
                                        <span t-esc="writeOpenButtonLabel"/>
                                    </button>
                                </div>
                            </div>
                        </t>


                        <div class="sh-ai-window-action-row mt-2">
                            <t t-if="props.message.action_data">
                                <div class="sh-ai-window-open-view-buttons">
                                    <button t-foreach="actionButtons" t-as="button" t-key="button.key" t-att-class="button.className + ' btn-sm sh-ai-window-open-view-button sh-ai-window-open-view-button-icon'" t-on-click="() => this.onOpenView(button.key)" t-att-title="button.label" t-att-disabled="props.isProcessing">
                                        <i t-att-class="'fa ' + button.icon"/>
                                    </button>
                                </div>
                            </t>

                            <t t-if="isDebugMode and isAdmin">
                                <button class="btn btn-sm btn-outline-secondary sh-ai-window-debug-toggle" t-on-click="toggleDebugInfo" title="Show executed domain (debug mode)" t-att-disabled="props.isProcessing">
                                    <i class="fa fa-bug me-1"/>
                                    <span t-if="!state.showDebugInfo">Show Query</span>
                                    <span t-else="">Hide Query</span>
                                </button>
                            </t>
                        </div>

                        <t t-if="isDebugMode and isAdmin">
                            <div t-if="state.showDebugInfo" class="sh-ai-window-debug-panel mt-2">
                                <div class="sh-ai-window-debug-header"><strong>Executed Query</strong></div>
                                <div class="sh-ai-window-debug-content">
                                    <div class="mb-2"><span class="text-muted">Model:</span> <code class="ms-2" t-esc="debugModel"/></div>
                                    <div class="mb-2"><span class="text-muted">Domain:</span> <pre class="sh-ai-window-debug-code mb-0"><code t-esc="debugDomainFormatted"/></pre></div>
                                    <t t-if="debugFields.length > 0"><span class="text-muted">Fields:</span> <pre class="sh-ai-window-debug-code mb-0"><code t-esc="debugFieldsFormatted"/></pre></t>

                                    <t t-if="toolLifecycleEvents.length">
                                        <div class="sh-ai-window-debug-section mt-2">
                                            <div class="small fw-bold mb-1">Turn Events</div>
                                            <div class="sh-ai-window-turn-event-list">
                                                <div t-foreach="toolLifecycleEvents" t-as="event" t-key="event.timestamp + event.type" class="sh-ai-window-turn-event-item">
                                                    <span class="sh-ai-window-turn-event-type" t-esc="formatEventType(event.type)"/>
                                                    <span class="sh-ai-window-turn-event-summary" t-esc="eventSummary(event)"/>
                                                </div>
                                            </div>
                                        </div>
                                    </t>

                                    <t t-if="Object.keys(providerCapabilities).length">
                                        <div class="sh-ai-window-debug-section mt-2">
                                            <div class="small fw-bold mb-1">Provider Capabilities</div>
                                            <div class="row g-0 small">
                                                <div class="col-6"><span class="text-muted">Tools:</span> <t t-esc="providerCapabilities.tool_calling ? 'yes' : 'no'"/></div>
                                                <div class="col-6"><span class="text-muted">Streaming:</span> <t t-esc="providerCapabilities.streaming ? 'yes' : 'no'"/></div>
                                                <div class="col-6"><span class="text-muted">Structured:</span> <t t-esc="providerCapabilities.structured_output || 'n/a'"/></div>
                                                <div class="col-6"><span class="text-muted">Cancel:</span> <t t-esc="providerCapabilities.cancellation || 'n/a'"/></div>
                                            </div>
                                        </div>
                                    </t>

                                    <div class="sh-ai-window-debug-section mt-2">
                                        <div class="small fw-bold mb-1">Usage Statistics</div>
                                        <div class="row g-0 small">
                                            <div class="col-6"><span class="text-muted">Tokens:</span> <t t-esc="usagePromptTokens"/> / <t t-esc="usageCompletionTokens"/></div>
                                            <div class="col-6"><span class="text-muted">Total:</span> <t t-esc="usageTotalTokens"/></div>
                                            <div class="col-6" t-if="usageReasoningTokens > -1"><span class="text-muted">Reasoning Tokens:</span> <t t-esc="usageReasoningTokens"/></div>
                                            <div class="col-6"><span class="text-muted">Tools:</span> <t t-esc="toolCallCount"/> calls</div>
                                            <div class="col-6"><span class="text-muted">Time:</span> <t t-esc="executionTime"/>s</div>
                                            <div class="col-6" t-if="props.message.sh_reasoning_effort"><span class="text-muted">Reasoning:</span> <t t-esc="reasoningEffortLabel"/></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-esc="props.message.content"/>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
