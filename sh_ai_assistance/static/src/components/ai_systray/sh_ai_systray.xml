<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sh_ai_assistance.AiChatSystray" owl="1">
        <!-- AI Systray Visibility Check -->
        <t t-if="!state.isLoading and state.hasAccess">
            <div class="o_sh_ai_chat_systray_item h-100 px-3 d-flex align-items-center position-relative cursor-pointer"
                 t-on-click="toggleChat"
                 title="AI Assistant">
                
                <img class="sh-ai-systray-icon"
                     src="/sh_ai_assistance/static/description/icon.png"
                     alt="AI Chat" />

                <!-- Chat Window Container (Uses simple click bubble for dropdown handling) -->
                <div t-if="state.isOpen" class="o_sh_ai_chat_window_container">
                    <AiChatWindow onClose.bind="onClose" />
                </div>
            </div>
        </t>
    </t>
</templates>
