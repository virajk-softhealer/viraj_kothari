<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sh_ai_assistance.AiChatWindow">
        <!-- Chat Window Wrapper -->
        <div class="sh-ai-chat-card glassmorphism elevation-lg d-flex flex-column animate-slide-up">
            <!-- Header -->
            <div class="sh-ai-chat-header d-flex justify-content-between align-items-center p-3 border-bottom">
                <div class="d-flex align-items-center flex-grow-1">
                    <img src="/sh_ai_assistance/static/description/icon.png" alt="AI" class="sh-ai-header-icon me-2" />
                    
                    <!-- Chat Selection Dropdown (Mini Chat) -->
                    <div class="dropdown me-2 flex-grow-1" t-if="!state.isLoading">
                        <button class="mini-chat-selector-btn btn btn-sm border-0 p-0 d-flex align-items-center"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                aria-expanded="false"
                                title="Recent Chats"
                                t-att-disabled="state.isProcessing">
                             <span class="mini-chat-title text-truncate d-inline-block" t-esc="state.currentSessionName"/>
                            <i class="fa fa-caret-down ms-1 flex-shrink-0 opacity-75"/>
                        </button>
                        <ul class="dropdown-menu mini-dropdown shadow-lg session-dropdown">
                            <li>
                                <button t-if="!shouldDisableNewChat" class="dropdown-item border-bottom pb-2 mb-1 d-flex align-items-center text-info"
                                        t-att-disabled="shouldDisableNewChat"
                                        t-att-title="newChatButtonTooltip"
                                        t-att-class="shouldDisableNewChat ? 'disabled' : ''"
                                        t-on-click="createNewSession">
                                    <i class="fa fa-plus-circle me-2"/>
                                    <span class="small fw-bold">New Conversation</span>
                                </button>
                            </li>
                            <t t-foreach="state.recentSessions" t-as="chat_session" t-key="chat_session.id">
                                <li>
                                    <button class="dropdown-item d-flex align-items-center"
                                            t-att-class="chat_session.id === state.currentSessionId ? 'active' : ''"
                                            t-on-click="() => this.selectSession(chat_session)">
                                        <i class="fa fa-comment-o me-2 small opacity-75"/>
                                        <span t-esc="chat_session.name" class="small text-truncate"/>
                                    </button>
                                </li>
                            </t>
                        </ul>
                    </div>
                    
                    <!-- Model Selection Dropdown -->
                    <div class="dropdown flex-shrink-1" t-if="!state.isLoading">
                        <button class="mini-model-selector-btn btn btn-sm border-0 opacity-75 hover-opacity-100 p-0 d-flex align-items-center"
                                type="button"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                aria-expanded="false"
                                title="AI Engine"
                                t-att-disabled="state.isProcessing">
                            <span t-if="state.selectedModel" t-esc="state.selectedModel.name" class="mini-model-title text-truncate d-inline-block"/>
                            <i class="fa fa-caret-down ms-1 flex-shrink-0 opacity-75"/>
                        </button>
                        <ul class="dropdown-menu mini-dropdown shadow-lg">
                            <t t-foreach="state.availableModels" t-as="model" t-key="model.id">
                                <li>
                                    <button class="dropdown-item d-flex align-items-center"
                                            t-on-click="() => this.selectModel(model)">
                                        <t t-if="model.image">
                                            <img class="model-avatar-img me-2"
                                                 style="width: 16px; height: 16px;"
                                                 t-att-src="'/web/image/sh.ai.llm/' + model.id + '/image'"
                                                 t-att-alt="model.name"/>
                                        </t>
                                        <span t-esc="model.name" class="small"/>
                                        <i t-if="model.id === state.selectedModel?.id" class="fa fa-check ms-auto text-success small"/>
                                    </button>
                                </li>
                            </t>
                        </ul>
                    </div>
                </div>

                <div class="sh-ai-chat-controls d-flex align-items-center gap-3">
                    <!-- Expand Action -->
                    <button class="sh-ai-header-action btn btn-sm btn-link p-0 opacity-75 hover-opacity-100" 
                            t-on-click="onExpand"
                            title="Expand to Dashboard"
                            t-att-disabled="state.isProcessing">
                        <i class="fa fa-expand"/>
                    </button>
                    <!-- Close Action -->
                    <i class="sh-ai-header-action fa fa-times cursor-pointer p-1" t-on-click="props.onClose" />
                </div>
            </div>

            <!-- Chat Main Component Integration -->
            <div class="sh-ai-chat-body flex-grow-1 overflow-hidden p-0 position-relative">
                <t t-if="state.isLoading">
                     <div class="d-flex justify-content-center align-items-center h-100">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                     </div>
                </t>
                <t t-else="">
                    <t t-if="state.currentSessionId">
                        <AiChatWindowContent 
                            sessionId="state.currentSessionId" 
                            sessionToken="state.currentSessionToken" 
                            selectedModel="state.selectedModel" 
                            onMessageSent.bind="onMessageSent"
                            onProcessingStateChanged.bind="onProcessingStateChanged"
                        />
                    </t>
                    <t t-else="">
                        <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                            <p>Loading Chat...</p>
                        </div>
                    </t>
                </t>
            </div>
        </div>
    </t>
</templates>
