<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sh_ai_assistance.AiChatContentTemplate">
        <div class="o-ai-ChatContent d-flex flex-column h-100 flex-grow-1">
            <!-- Messages Area with Scroll Navigation -->
            <div class="messages-area-container flex-grow-1">
                <div class="o-ai-ChatMessages h-100 overflow-auto p-4" t-ref="messagesContainer">
                    <!-- Loading State -->
                    <t t-if="state.isFetchLoading">
                        <div class="ai-content-loading">
                            <i class="fa fa-spinner fa-spin fa-2x mb-3 text-primary"/>
                            <div class="text-muted">Loading messages...</div>
                        </div>
                    </t>

                    <t t-elif="state.messages.length === 0">
                        <div class="ai-empty-state">
                            <div class="ai-empty-hero">
                                <div class="ai-welcome-section">
                                    <div class="ai-avatar-container">
                                        <t t-if="props.selectedModel and props.selectedModel.image and props.selectedModel.id">
                                            <img class="ai-welcome-avatar"
                                                 t-att-src="'/web/image/sh.ai.llm/' + props.selectedModel.id + '/image'"
                                                 t-att-alt="props.selectedModel.name"/>
                                        </t>
                                        <t t-else="">
                                            <div class="ai-welcome-avatar ai-default-welcome-avatar">
                                                <span class="ai-icon">AI</span>
                                            </div>
                                        </t>
                                    </div>

                                    <div class="ai-welcome-text">
                                        <div class="ai-demo-pill">Live Odoo assistant</div>
                                        <h2 class="ai-welcome-title">
                                            <t t-if="props.selectedModel and props.selectedModel.name">
                                                <t t-esc="props.selectedModel.name"/>
                                            </t>
                                            <t t-else="">
                                                Ask AI
                                            </t>
                                        </h2>
                                        <p class="ai-welcome-subtitle">Ask about live records, grouped summaries, or open matching Odoo views.</p>
                                    </div>
                                </div>

                                <div class="ai-highlight-grid">
                                    <div t-foreach="emptyStateHighlights" t-as="highlight" t-key="highlight.title" class="ai-highlight-card">
                                        <div class="ai-highlight-icon">
                                            <i t-att-class="'fa ' + highlight.icon"/>
                                        </div>
                                        <div class="ai-highlight-body">
                                            <div class="ai-highlight-title" t-esc="highlight.title"/>
                                            <div class="ai-highlight-description" t-esc="highlight.description"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="ai-demo-questions">
                                <div class="ai-demo-header">
                                    <div>
                                        <h3 class="ai-demo-title">Try these demo prompts</h3>
                                        <p class="ai-demo-subtitle">Good demo prompts make the assistant show real data, grouped answers, and navigation actions.</p>
                                    </div>
                                </div>
                                <div class="ai-question-cards">
                                    <button t-foreach="suggestedQuestions" t-as="question" t-key="question"
                                            class="ai-question-card"
                                            t-on-click="() => this.selectDemoQuestion(question)">
                                        <div class="question-bulb-icon">
                                            <i class="fa fa-lightbulb-o"></i>
                                        </div>
                                        <div class="ai-question-content">
                                            <span class="ai-question-text" t-esc="question"/>
                                        </div>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-foreach="state.messages" t-as="message" t-key="message_index">
                        <ChatMessage message="message"
                                   messageIndex="message_index"
                                   currentUser="currentUser"
                                   currentLlm="props.selectedModel"
                                   availableModels="props.availableModels"
                                   onWriteRequestChanged.bind="onWriteRequestChanged"/>
                    </t>

                    <t t-if="state.isProcessing">
                        <AiTypingIndicator
                            currentLlm="props.selectedModel"
                            currentUser="currentUser"
                            currentStageTitle="currentProcessingStatus.title"
                            currentStageHint="currentProcessingStatus.detail"/>
                    </t>
                </div>

            </div>

            <!-- Enhanced Input Area -->
            <div class="o-ai-ChatInput enhanced-chat-input">
                <div class="view-preference-toolbar mb-2 d-flex align-items-center gap-2">
                    <small class="text-muted">Open view actions:</small>
                    <select class="form-select form-select-sm view-pref-select"
                            style="max-width: 180px;"
                            t-att-value="state.viewPreference"
                            t-on-change="onViewPreferenceChange"
                            t-att-disabled="state.isProcessing">
                        <option value="auto">Auto</option>
                        <option value="show">Always Show</option>
                        <option value="hide">Hide</option>
                    </select>
                    <span class="view-pref-hint text-muted" t-esc="viewPreferenceHelpText"/>
                </div>

                <div t-if="state.isListening" class="ai-speech-live-panel">
                    <div class="speech-live-header">
                        <div class="speech-indicator-wrapper">
                            <div class="voice-wave-container">
                                <div class="wave-bar"></div>
                                <div class="wave-bar"></div>
                                <div class="wave-bar"></div>
                                <div class="wave-bar"></div>
                                <div class="wave-bar"></div>
                            </div>
                            <span class="pulse-text">Listening...</span>
                        </div>
                        <button class="btn btn-sm discard-btn" t-on-click="discardSpeech" title="Discard">
                            <i class="fa fa-times-circle"/>
                        </button>
                    </div>
                    <div class="speech-live-content">
                        <div class="transcript-wrapper">
                            <span class="speech-text-final" t-esc="state.currentQuery"/>
                            <span class="speech-text-interim" t-esc="state.interimTranscript"/>
                        </div>
                    </div>
                </div>

                <div class="input-container">
                    <!-- User Avatar -->
                    <div class="user-avatar-section">
                        <t t-if="currentUser.id and currentUser.id !== 'undefined'">
                            <img class="user-avatar"
                                 t-att-src="'/web/image/res.users/' + currentUser.id + '/avatar_128'"
                                 t-att-alt="currentUser.name"/>
                        </t>
                        <t t-else="">
                            <div class="user-avatar default-avatar">
                                <i class="fa fa-user"/>
                            </div>
                        </t>
                    </div>

                    <!-- Input Field Area -->
                    <div class="input-field-area">
                        <div class="input-wrapper">
                            <textarea class="enhanced-textarea"
                                      placeholder="Ask about contacts, sales, invoices, stock, employees, or any live Odoo data..."
                                      t-model="state.currentQuery"
                                      t-on-keypress="onKeyPress"
                                      t-on-input="onInputChange"
                                      t-ref="textInput"
                                      t-att-disabled="state.isProcessing or state.isListening"
                                      rows="1"></textarea>

                            <!-- Character Counter -->
                            <div t-if="state.currentQuery.length > 100" class="char-counter">
                                <t t-esc="state.currentQuery.length"/>/10000
                            </div>

                            <!-- Shift+Enter Hint -->
                            <div t-if="state.showShiftEnterHint" class="hint-tooltip">
                                Press Shift+Enter for new line
                            </div>
                        </div>
                    </div>

                    <!-- Send Button Section -->
                    <div class="send-button-section d-flex gap-2">
                        <!-- Speech Recognition Button -->
                        <button t-if="state.speechSupported and !state.isProcessing"
                                class="ai-speech-button"
                                t-att-class="{ 'listening': state.isListening }"
                                type="button"
                                tabindex="-1"
                                t-on-click="toggleSpeechRecognition"
                                t-att-title="state.isListening ? 'Stop Listening' : 'Speech to Text'">
                            <i class="fa fa-microphone"/>
                        </button>

                        <!-- Stop Button -->
                        <button t-if="state.isProcessing"
                                class="btn btn-danger btn-sm rounded-circle d-flex align-items-center justify-content-center"
                                style="width: 36px; height: 36px;"
                                type="button"
                                t-on-click="stopProcessing"
                                title="Stop Generation">
                            <i class="fa fa-stop" style="font-size: 14px;"/>
                        </button>

                        <button t-if="!state.isProcessing" class="enhanced-send-button"
                                t-att-class="state.isProcessing ? 'processing' : (state.currentQuery.trim() ? 'ready' : 'disabled')"
                                type="button"
                                t-on-click="sendMessage"
                                t-att-disabled="state.isProcessing or !state.currentQuery.trim()">

                            <i t-if="!state.isProcessing" class="fa fa-paper-plane"/>
                        </button>
                    </div>
                </div>

                <!-- Provider Warning Message -->
                <div class="ai-input-help-row">
                    <span>Enter to send</span>
                    <span>Shift+Enter for a new line</span>
                    <span>Use Open view actions to control whether record-opening buttons are attached to AI answers</span>
                </div>

                <div t-if="providerWarningMessage" class="py-1 text-center" style="font-size: 11px; color: #6c757d;">
                    <i class="fa fa-exclamation-triangle me-1" style="font-size: 10px; color: rgb(255, 0, 0);"/>
                    <t t-esc="providerWarningMessage"/><span class="o_tooltip" data-tooltip="If output is not what you expect, refine the question and adjust Open view actions mode (Auto, Always Show, Hide)." style="font-size: 10px; color:rgb(212, 202, 0); cursor: pointer;">Tips <i class="fa fa-lightbulb-o"></i></span>
                </div>
            </div>
        </div>
    </t>
</templates>
