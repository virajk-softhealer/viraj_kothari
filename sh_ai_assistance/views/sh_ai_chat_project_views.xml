<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Chat Project List View -->
    <record id="sh_ai_chat_project_view_list" model="ir.ui.view">
        <field name="name">sh.ai.chat.project.list</field>
        <field name="model">sh.ai.chat.project</field>
        <field name="arch" type="xml">
            <list string="Chat Projects">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="user_id"/>
                <field name="session_count"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Chat Project Search View -->
    <record id="sh_ai_chat_project_view_search" model="ir.ui.view">
        <field name="name">sh.ai.chat.project.search</field>
        <field name="model">sh.ai.chat.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="user_id"/>
            </search>
        </field>
    </record>

    <!-- Chat Project Form View -->
    <record id="sh_ai_chat_project_view_form" model="ir.ui.view">
        <field name="name">sh.ai.chat.project.form</field>
        <field name="model">sh.ai.chat.project</field>
        <field name="arch" type="xml">
            <form string="Chat Project">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Project Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="session_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sessions" name="sessions">
                            <field name="session_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="llm_id"/>
                                    <field name="last_message_date"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Child Projects" name="child_projects">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="session_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Chat Project Action -->
    <record id="action_sh_ai_chat_project" model="ir.actions.act_window">
        <field name="name">Chat Projects</field>
        <field name="res_model">sh.ai.chat.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="sh_ai_chat_project_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create projects to organize your chats!
            </p>
        </field>
    </record>

</odoo>
